{
  "title": "Facebook Posts to PDF Workflow",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "facebookProfileUrl": {
      "title": "Facebook Profile URL",
      "type": "string",
      "description": "Facebook profile to archive.",
      "editor": "textfield"
    },
    "resultsLimit": {
      "title": "Maximum posts",
      "type": "integer",
      "description": "Maximum posts requested from the Posts Scraper.",
      "default": 20,
      "minimum": 1
    },
    "photosResultsLimit": {
      "title": "Maximum photos (entire run)",
      "type": "integer",
      "description": "Global maximum number of photo records returned by one Photos Scraper run across all posts; not a per-post limit.",
      "default": 100,
      "minimum": 1
    },
    "onlyPostsNewerThan": {
      "title": "Only Posts Newer Than",
      "type": "string",
      "description": "Posts newer than YYYY-MM-DD.",
      "editor": "textfield",
      "default": "2025-12-31",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "viewportWidth": {
      "title": "Viewport width",
      "type": "integer",
      "description": "Screenshot viewport width in pixels.",
      "default": 800,
      "minimum": 1
    },
    "viewportHeight": {
      "title": "Viewport height",
      "type": "integer",
      "description": "Screenshot viewport height in pixels.",
      "default": 1280,
      "minimum": 1
    },
    "maxImageHeight": {
      "title": "Maximum image height",
      "type": "integer",
      "description": "Maximum screenshot raster height before PDF fitting; zero disables resizing.",
      "default": 1400,
      "minimum": 0
    },
    "pageSize": {
      "title": "PDF page size",
      "type": "string",
      "description": "Paper size.",
      "editor": "select",
      "enum": [
        "LETTER",
        "A4"
      ],
      "default": "LETTER"
    }
  },
  "required": [
    "facebookProfileUrl"
  ]
}
